# Looker / Portal C6 Consig (WebAutorizador)
LOOKER_URL=https://c6.c6consig.com.br/WebAutorizador/Login/AC.UI.LOGIN.aspx
LOOKER_USER=usuario@empresa.com
LOOKER_PASSWORD=coloque_a_senha_aqui

# Notificação por e-mail (relatório consolidado de cada execução).
# Canal preferido: Microsoft Graph - NÃO depende de "Authenticated SMTP".
# App Registration no Azure AD + permissão de APLICAÇÃO "Mail.Send" (com
# consentimento do admin). GRAPH_SENDER = caixa remetente.
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GRAPH_SENDER=automacao@empresa.com.br
MAIL_TO=unica.tech@unicapromotora.com.br

# Canal 2 (usado se GRAPH_* ficar vazio): Outlook Desktop via COM/pywin32.
# Usa o Outlook já instalado e logado na máquina de automação - sem SMTP
# AUTH e sem App Registration. Ligado por padrão; desligue com:
# MAIL_OUTLOOK=false

# Canal 3 (fallback): SMTP autenticado (usado só se GRAPH_* vazio E
# MAIL_OUTLOOK=false ou Outlook falhar). Exige "Authenticated SMTP".
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=conta-de-envio@unicapromotora.com.br
SMTP_PASSWORD=senha_ou_app_password
SMTP_FROM=conta-de-envio@unicapromotora.com.br
SMTP_TO=unica.tech@unicapromotora.com.br

# SharePoint (App Registration no Azure AD)
SHAREPOINT_SITE_URL=https://empresa.sharepoint.com/sites/DadosC6
SHAREPOINT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHAREPOINT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_ROOT_FOLDER=/Documentos Compartilhados/BI C6 Auto

# Pastas locais/OneDrive das planilhas "Prévia" e "de origem oficial" de cada
# base (ver config.py) - por padrão apontam para pastas de exemplo, ajuste
# para o caminho real sincronizado no seu OneDrive.
PREVIA_NUMERO_CONTRATOS_DIR=C:\Users\usuario\OneDrive - empresa.com.br\Documentos\Projetos\RPA - Analítico de Produção - C6 Auto\Bases Previa\Número de Contratos - Previa
PLANILHA_ORIGEM_NUMERO_CONTRATOS_DIR=C:\Users\usuario\OneDrive - empresa.com.br\Documentos\Projetos\RPA - Analítico de Produção - C6 Auto\Bases Price\Número de Contratos

