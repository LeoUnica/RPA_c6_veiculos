# SharePoint (App Registration no Azure AD)
SHAREPOINT_SITE_URL=https://empresa.sharepoint.com/sites/DadosC6
SHAREPOINT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHAREPOINT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_ROOT_FOLDER=/Documentos Compartilhados/BI C6 Auto

